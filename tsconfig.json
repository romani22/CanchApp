{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"jsx": "react-jsx",
		"paths": {
			"@/*": ["./*"]
		},
		"types": ["jest"]
	},
	"include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
	// Las edge functions corren en Deno: globales propios (Deno.env) e imports jsr:.
	// Chequearlas con el tsconfig de la app daba 6 errores que nunca fueron reales.
	// Supabase las valida por su cuenta al hacer deploy.
	"exclude": ["node_modules", "supabase/functions/**"]
}
