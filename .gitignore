# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
# package-lock.json NO va acá: EAS Build arma el archivo de subida respetando
# .gitignore, así que ignorarlo hacía que el builder no lo recibiera, cayera a
# yarn y resolviera dependencias desde cero en cada build (no reproducible).

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
# .env tampoco va acá: sólo contiene variables EXPO_PUBLIC_*, que terminan
# empaquetadas dentro del APK igual (son públicas por diseño). Si se ignora,
# EAS no lo sube y la app se compila sin la URL de Supabase.
# Los secretos de verdad viven en .env.local, que sí se ignora.
.env*.local

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android
